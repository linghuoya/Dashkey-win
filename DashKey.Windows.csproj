<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <!--
      关闭 SDK 的隐式 using，改由 GlobalUsings.cs 显式声明。
      原因：UseWindowsForms 打开时，隐式 using 会额外全局导入 System.Drawing 与
      System.Windows.Forms，与 WPF 的 Brush / Color / Image / Brushes / FontFamily /
      HorizontalAlignment / Cursors 等同名类型冲突（CS0104）；
      而在项目里手动 Remove 这两个 Using 项又会连带影响隐式 using 的生成（实测会丢掉 System.IO）。
      显式声明后编译结果只依赖 C# 语义，不依赖 SDK 的隐式行为。
    -->
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <AssemblyName>DashKey</AssemblyName>
    <RootNamespace>DashKey</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\DashKey.ico</ApplicationIcon>

    <Version>1.1.0</Version>
    <Company>DashKey</Company>
    <Product>DashKey</Product>
    <AssemblyTitle>DashKey</AssemblyTitle>
    <Description>任务栏应用快捷键切换器</Description>

    <PublishSingleFile>true</PublishSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\DashKey.ico" />
  </ItemGroup>

</Project>
